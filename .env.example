# =============================================================================
# ClipFusion AI — environment configuration
# Copy to `.env` (repo root) and fill in. Never commit real secrets.
# =============================================================================

# ----------------------------------------------------------------- application
ENVIRONMENT=development                 # development | test | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
BACKEND_PUBLIC_URL=http://localhost:8010   # public base URL of the API (OAuth redirect URIs + signed media URLs; API port 8010)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# -------------------------------------------------------------------- security
# false = no login (single local user, answers on this computer only; refused in production)
# true  = accounts with email/password
AUTH_REQUIRED=false
# Only for running without login inside Docker, with ports published on 127.0.0.1: the Docker gateway network
NO_LOGIN_TRUSTED_NETWORKS=
# REQUIRED in production (>= 32 chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Fernet key(s) for encrypting OAuth tokens at rest. Comma-separated; the first encrypts, all decrypt.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false                     # true behind HTTPS
COOKIE_DOMAIN=                          # e.g. .example.com when API and app are on sibling subdomains
MEDIA_URL_TTL_SECONDS=21600

# -------------------------------------------------------------------- database
DATABASE_URL=postgresql+psycopg://clipfusion:clipfusion@localhost:5432/clipfusion
DATABASE_ECHO=false

# --------------------------------------------------------- background workers
WORKER_MODE=celery                      # celery (Redis + Celery workers) | local (in-process, dev only)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=                      # defaults to REDIS_URL
CELERY_RESULT_BACKEND=                  # defaults to REDIS_URL
LOCAL_WORKER_THREADS=2
JOB_HEARTBEAT_TIMEOUT_SECONDS=900
JOB_MAX_ATTEMPTS=3

# --------------------------------------------------------------------- storage
STORAGE_BACKEND=local                   # local | s3 (AWS S3, Cloudflare R2, MinIO, ...)
# LOCAL_STORAGE_DIR=/absolute/path/to/storage   # default: backend/data/storage
# TEMP_DIR=/absolute/path/to/tmp                # default: backend/data/tmp
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=                        # R2: https://<account_id>.r2.cloudflarestorage.com  MinIO: http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_TTL_SECONDS=21600

# --------------------------------------------------------------------- uploads
MAX_UPLOAD_BYTES=21474836480            # 20 GB
UPLOAD_CHUNK_BYTES=16777216             # 16 MB
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.webm,.avi,.m4v
MAX_VIDEO_DURATION_SECONDS=21600

# ----------------------------------------------------------------------- media
FFMPEG_PATH=                            # optional explicit paths; otherwise PATH, then imageio-ffmpeg
FFPROBE_PATH=
# MODELS_DIR=/absolute/path             # default: backend/models  (face detector models, scripts/download_assets.py)
# Free space that must stay available on the storage/temp disks (uploads, imports and renders are refused below it)
MIN_FREE_DISK_MB=2048
# How often uploaded clips are re-checked with YouTube before their media is deleted (seconds)
UPLOAD_VERIFY_INTERVAL_SECONDS=300

# --------------------------------------------------------------- transcription
WHISPER_MODEL=small                     # tiny | base | small | medium | large-v3 | distil-large-v3 ...
WHISPER_DEVICE=auto                     # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=auto               # auto | int8 | int8_float16 | float16 | float32
# WHISPER_CACHE_DIR=/absolute/path      # default: Hugging Face cache

# ------------------------------------------------------------- face detection
FACE_DETECTOR=auto                      # auto | yunet | mediapipe | haar

# ------------------------------------------------------- LLM (Anthropic Claude)
# Optional. Without a key, highlight detection uses signal-based scoring only and titles/
# captions/hashtags are generated extractively — the UI labels which method was used.
ANTHROPIC_API_KEY=
LLM_ENABLED=true
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium                       # low | medium | high | xhigh | max
LLM_MAX_TRANSCRIPT_CHARS=600000

# ------------------------------------------------------------ AI providers
# auto = Claude when ANTHROPIC_API_KEY is set, otherwise the free local default.
TRANSCRIPTION_PROVIDER=faster_whisper   # local faster-whisper (GPU when the NVIDIA libraries are installed)
HIGHLIGHT_RANKER=auto                   # auto | signals (free, local) | claude (paid)
METADATA_PROVIDER=auto                  # auto | extractive (free, local) | claude (paid)
# Video encoder for renders/proxies: auto = NVIDIA NVENC when FFmpeg can use it, else libx264
VIDEO_ENCODER=auto
# GPU transcription needs (about 1 GB download):
#   uv pip install --python backend\.venv\Scripts\python.exe nvidia-cublas-cu12 nvidia-cudnn-cu12

# ------------------------------------------------------ Google / YouTube (OAuth)
# Google Cloud Console -> APIs & Services: enable "YouTube Data API v3", "YouTube Analytics API"
# (and "Google Drive API" for Drive import). OAuth client type: Web application.
# Authorized redirect URI: {BACKEND_PUBLIC_URL}/api/v1/accounts/callback/google
# Sign-in with Google redirect URI:  {BACKEND_PUBLIC_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=                        # optional: public video metadata lookups without OAuth
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_UPLOAD_QUOTA_COST=1600
YOUTUBE_UPLOAD_CHUNK_BYTES=8388608

# ------------------------------------------------------------ Meta / Instagram
# instagram_login -> "Instagram API with Instagram Login" (graph.instagram.com), scopes:
#                    instagram_business_basic, instagram_business_content_publish
#                    redirect URI: {BACKEND_PUBLIC_URL}/api/v1/accounts/callback/instagram
# facebook_login  -> "Instagram API with Facebook Login" (graph.facebook.com + linked Facebook Page), scopes:
#                    instagram_basic, instagram_content_publish, pages_show_list, pages_read_engagement,
#                    business_management   redirect URI: {BACKEND_PUBLIC_URL}/api/v1/accounts/callback/facebook
# unified_login   -> "Instagram API with Unified Login" (new Meta apps; no Facebook Page): META_APP_ID,
#                    META_APP_SECRET, INSTAGRAM_CONFIG_ID (Configuration ID) and an HTTPS redirect URI, e.g.
#                    INSTAGRAM_REDIRECT_URI=https://localhost:8011/api/v1/accounts/callback/instagram
#                    (served locally by backend/scripts/https_callback.py, started by start.ps1)
INSTAGRAM_AUTH_FLOW=instagram_login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_CONFIG_ID=
INSTAGRAM_REDIRECT_URI=
META_GRAPH_VERSION=v23.0
INSTAGRAM_DAILY_PUBLISH_LIMIT=50

# ---------------------------------------------------------------- rate limits
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=600/minute
RATE_LIMIT_STORAGE_URI=                 # defaults to REDIS_URL in celery mode, memory otherwise

# -------------------------------------------------------------------- frontend
NEXT_PUBLIC_API_URL=http://localhost:8010/api/v1
NEXT_PUBLIC_APP_NAME=ClipFusion AI
